{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCloudDocsObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::clouddocs-dev-private",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["documents", "documents/*"]
        }
      }
    },
    {
      "Sid": "ManageCloudDocsObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::clouddocs-dev-private/documents/*"
    }
  ]
}
